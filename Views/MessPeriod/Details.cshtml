@model MessManagement.Models.MessPeriod
@{
    ViewData["Title"] = "Mess Period Details";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="layout-dashboard" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "MessPeriod")" class="breadcrumb-link">Mess Periods</a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Details</span>
    </nav>
    <h1 class="page-title">
        <span class="page-title-icon">
            <i data-lucide="calendar-range" class="w-6 h-6"></i>
        </span>
        Mess Period Details
    </h1>
</div>

<div class="max-w-2xl">
    <div class="card">
        <div class="card-body">
            <!-- Period Header -->
            <div class="flex items-center gap-6 mb-8 pb-6 border-b border-gray-100">
                <div class="w-20 h-20 rounded-2xl bg-linear-to-br from-purple-500 to-purple-600 flex items-center justify-center">
                    <i data-lucide="calendar-range" class="w-10 h-10 text-white"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">@Model.PeriodName</h2>
                    <p class="text-gray-500">@Model.StartDate.ToString("MMMM dd") - @Model.EndDate.ToString("MMMM dd, yyyy")</p>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success mt-2">
                            <i data-lucide="check-circle" class="w-3 h-3 mr-1"></i>
                            Active Period
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-gray mt-2">
                            <i data-lucide="circle" class="w-3 h-3 mr-1"></i>
                            Inactive
                        </span>
                    }
                </div>
            </div>

            <!-- Period Details -->
            <div class="grid gap-4">
                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                    <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center">
                        <i data-lucide="tag" class="w-5 h-5 text-cyan-600"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Period Name</p>
                        <p class="font-medium text-gray-900">@Model.PeriodName</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                        <i data-lucide="calendar" class="w-5 h-5 text-emerald-600"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Start Date</p>
                        <p class="font-medium text-gray-900">@Model.StartDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center">
                        <i data-lucide="calendar-check" class="w-5 h-5 text-purple-600"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">End Date</p>
                        <p class="font-medium text-gray-900">@Model.EndDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                    <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center">
                        <i data-lucide="droplets" class="w-5 h-5 text-cyan-600"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Water Charge</p>
                        <p class="font-semibold text-lg text-gray-900">$@Model.FixedWaterCharge.ToString("N2")</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                        <i data-lucide="coffee" class="w-5 h-5 text-amber-600"></i>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Tea Price per Cup</p>
                        <p class="font-semibold text-lg text-gray-900">$@Model.TeaPricePerCup.ToString("N2")</p>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-end gap-3 pt-6 border-t border-gray-100 mt-6">
                <a asp-action="Index" class="btn btn-secondary">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.PeriodId" class="btn btn-primary">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                    Edit Period
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.initLucideIcons();
    </script>
}
