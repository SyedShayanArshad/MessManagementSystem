@model IEnumerable<MessManagement.Models.MessPeriod>
@{
    ViewData["Title"] = "Mess Periods";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="layout-dashboard" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Mess Periods</span>
    </nav>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <i data-lucide="calendar-range" class="w-6 h-6"></i>
                </span>
                Mess Periods
            </h1>
            <p class="page-description">Manage billing periods for the mess. Track active and past periods.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            Create New Period
        </a>
    </div>
</div>

<!-- Success Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-6" role="alert">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Summary Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    @{
        var totalPeriods = Model.Count();
        var activePeriods = Model.Count(p => p.IsActive);
    }
    <div class="stat-card">
        <div class="stat-icon bg-cyan-100">
            <i data-lucide="calendar" class="w-6 h-6 text-cyan-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@totalPeriods</div>
            <div class="stat-label">Total Periods</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-emerald-100">
            <i data-lucide="check-circle" class="w-6 h-6 text-emerald-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@activePeriods</div>
            <div class="stat-label">Active Periods</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-gray-100">
            <i data-lucide="archive" class="w-6 h-6 text-gray-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@(totalPeriods - activePeriods)</div>
            <div class="stat-label">Archived</div>
        </div>
    </div>
</div>

<!-- Periods Table -->
<div class="card">
    <div class="card-header">
        <div class="flex items-center justify-between">
            <h3 class="card-title">
                <i data-lucide="list" class="w-5 h-5 text-cyan-600"></i>
                All Periods
            </h3>
            <span class="badge badge-primary">@totalPeriods Total</span>
        </div>
    </div>
    @if (Model.Any())
    {
        <div class="table-container">
            <table class="data-table" role="grid" aria-label="Mess periods list">
                <thead>
                    <tr>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="tag" class="w-4 h-4"></i>
                                Period Name
                            </span>
                        </th>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="calendar" class="w-4 h-4"></i>
                                Start Date
                            </span>
                        </th>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="calendar" class="w-4 h-4"></i>
                                End Date
                            </span>
                        </th>
                        <th scope="col" class="text-center">
                            <span class="flex items-center justify-center gap-2">
                                <i data-lucide="activity" class="w-4 h-4"></i>
                                Status
                            </span>
                        </th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(p => p.StartDate))
                    {
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl @(item.IsActive ? "bg-emerald-100" : "bg-gray-100") flex items-center justify-center">
                                        <i data-lucide="calendar-range" class="w-5 h-5 @(item.IsActive ? "text-emerald-600" : "text-gray-500")"></i>
                                    </div>
                                    <span class="font-medium text-gray-900">@item.PeriodName</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-gray-600">@item.StartDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>
                                <span class="text-gray-600">@item.EndDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">
                                        <span class="status-dot active"></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-gray">
                                        <span class="status-dot inactive"></span>
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.PeriodId" 
                                       class="table-action table-action-edit"
                                       aria-label="Edit @item.PeriodName">
                                        <i data-lucide="pencil" class="w-3.5 h-3.5 mr-1"></i>
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.PeriodId" 
                                       class="table-action table-action-delete"
                                       aria-label="Delete @item.PeriodName">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5 mr-1"></i>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i data-lucide="calendar-x" class="w-16 h-16 text-gray-300"></i>
                </div>
                <h3 class="empty-state-title">No Periods Created</h3>
                <p class="empty-state-description">Create your first billing period to get started.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    Create First Period
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        window.initLucideIcons();
    </script>
}
