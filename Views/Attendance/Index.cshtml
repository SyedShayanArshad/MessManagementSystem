@section Scripts {
    <script>
        // Period selector change handler
        function changePeriod(periodId) {
            const url = new URL(window.location.href);
            url.searchParams.set('periodId', periodId);
            url.searchParams.delete('date');
            window.location.href = url.toString();
        }
        
        // Dish prices lookup
        const dishPrices = {
            breakfast: {},
            lunch: {},
            dinner: {}
        };
        
        // Initialize prices from select options
        function initPrices() {
            document.querySelectorAll('select[data-meal="breakfast"]').forEach(select => {
                if (select.dataset.index === '0') {
                    Array.from(select.options).forEach(opt => {
                        if (opt.value) {
                            const match = opt.text.match(/Rs\.\s*(\d+)/);
                            if (match) dishPrices.breakfast[opt.value] = parseFloat(match[1]);
                        }
                    });
                }
            });
            document.querySelectorAll('select[data-meal="lunch"]').forEach(select => {
                if (select.dataset.index === '0') {
                    Array.from(select.options).forEach(opt => {
                        if (opt.value) {
                            const match = opt.text.match(/Rs\.\s*(\d+)/);
                            if (match) dishPrices.lunch[opt.value] = parseFloat(match[1]);
                        }
                    });
                }
            });
            document.querySelectorAll('select[data-meal="dinner"]').forEach(select => {
                if (select.dataset.index === '0') {
                    Array.from(select.options).forEach(opt => {
                        if (opt.value) {
                            const match = opt.text.match(/Rs\.\s*(\d+)/);
                            if (match) dishPrices.dinner[opt.value] = parseFloat(match[1]);
                        }
                    });
                }
            });
        }
        
        // Set all checkboxes for a meal
        function setAllMeal(meal, checked) {
            document.querySelectorAll(`input[data-meal="${meal}"]`).forEach(cb => {
                // Skip disabled checkboxes (verified meals)
                if (!cb.disabled) {
                    cb.checked = checked;
                }
            });
            calculateTotals();
            updateCounts();
        }
        
        // Update meal counts
        function updateCounts() {
            let breakfastCount = 0, lunchCount = 0, dinnerCount = 0;
            
            document.querySelectorAll('tbody tr').forEach((row, index) => {
                const bfCheckbox = row.querySelector(`input[name="Items[${index}].IsBreakfastPresent"]`);
                const lunchCheckbox = row.querySelector(`input[name="Items[${index}].IsLunchPresent"]`);
                const dinnerCheckbox = row.querySelector(`input[name="Items[${index}].IsDinnerPresent"]`);
                
                if (bfCheckbox?.checked) breakfastCount++;
                if (lunchCheckbox?.checked) lunchCount++;
                if (dinnerCheckbox?.checked) dinnerCount++;
            });
            
            document.getElementById('breakfast-count').textContent = breakfastCount;
            document.getElementById('lunch-count').textContent = lunchCount;
            document.getElementById('dinner-count').textContent = dinnerCount;
        }
        
        // Calculate totals
        function calculateTotals() {
            let grandTotal = 0;
            
            document.querySelectorAll('tbody tr').forEach((row, index) => {
                let userTotal = 0;
                
                // Breakfast
                const bfCheckbox = row.querySelector(`input[name="Items[${index}].IsBreakfastPresent"]`);
                const bfSelect = row.querySelector(`select[name="Items[${index}].BreakfastDishPlanId"]`);
                if (bfCheckbox?.checked && bfSelect?.value) {
                    const price = dishPrices.breakfast[bfSelect.value] || 0;
                    userTotal += price;
                }
                
                // Lunch
                const lunchCheckbox = row.querySelector(`input[name="Items[${index}].IsLunchPresent"]`);
                const lunchSelect = row.querySelector(`select[name="Items[${index}].LunchDishPlanId"]`);
                if (lunchCheckbox?.checked && lunchSelect?.value) {
                    const price = dishPrices.lunch[lunchSelect.value] || 0;
                    userTotal += price;
                }
                
                // Dinner
                const dinnerCheckbox = row.querySelector(`input[name="Items[${index}].IsDinnerPresent"]`);
                const dinnerSelect = row.querySelector(`select[name="Items[${index}].DinnerDishPlanId"]`);
                if (dinnerCheckbox?.checked && dinnerSelect?.value) {
                    const price = dishPrices.dinner[dinnerSelect.value] || 0;
                    userTotal += price;
                }
                
                grandTotal += userTotal;
                
                // Update user total
                const totalBadge = row.querySelector('.user-total');
                if (totalBadge) {
                    totalBadge.textContent = `Rs. ${userTotal.toLocaleString()}`;
                }
            });
            
            // Update grand total
            document.getElementById('grand-total').textContent = `Rs. ${grandTotal.toLocaleString()}`;
        }
        
        // Initialize attendance page
        function initAttendancePage() {
            lucide.createIcons();
            initPrices();
            calculateTotals();
            updateCounts();
            
            // Add event listeners for checkboxes and selects
            document.querySelectorAll('.meal-checkbox, .meal-select').forEach(el => {
                el.addEventListener('change', () => {
                    calculateTotals();
                    updateCounts();
                });
            });
            
            // Handle date change to load attendance for new date
            document.getElementById('attendance-date')?.addEventListener('change', function() {
                const newDate = this.value;
                if (newDate) {
                    const url = new URL(window.location.href);
                    url.searchParams.set('date', newDate);
                    window.location.href = url.toString();
                }
            });
        }
        
        // Initialize on page load
        initAttendancePage();
        
        // Also reinitialize when SPA loads this content
        document.addEventListener('spa:contentLoaded', initAttendancePage);
    </script>
}
