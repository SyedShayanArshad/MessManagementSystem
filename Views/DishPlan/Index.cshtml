@model IEnumerable<MessManagement.Models.DishPlan>
@{
    ViewData["Title"] = "Weekly Dish Plans";
    var daysOfWeek = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    var breakfastDishes = Model.Where(d => d.MealType == "Breakfast").ToList();
    var lunchDishes = Model.Where(d => d.MealType == "Lunch").ToList();
    var dinnerDishes = Model.Where(d => d.MealType == "Dinner").ToList();
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="layout-dashboard" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Dish Plans</span>
    </nav>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon bg-orange-100">
                    <i data-lucide="chef-hat" class="w-6 h-6 text-white"></i>
                </span>
                Weekly Dish Plans
            </h1>
            <p class="page-description">Manage your weekly menu by meal type. Add dishes for breakfast, lunch, and dinner.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            Add New Dish
        </a>
    </div>
</div>

<!-- Success Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-6" role="alert">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Summary Stats -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="stat-card">
        <div class="stat-icon bg-orange-100">
            <i data-lucide="chef-hat" class="w-6 h-6 text-orange-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@Model.Count()</div>
            <div class="stat-label">Total Dishes</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-amber-100">
            <i data-lucide="sunrise" class="w-6 h-6 text-amber-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@breakfastDishes.Count</div>
            <div class="stat-label">Breakfast Dishes</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-blue-100">
            <i data-lucide="sun" class="w-6 h-6 text-cyan-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@lunchDishes.Count</div>
            <div class="stat-label">Lunch Dishes</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-purple-100">
            <i data-lucide="moon" class="w-6 h-6 text-purple-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@dinnerDishes.Count</div>
            <div class="stat-label">Dinner Dishes</div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <!-- ========================================== -->
    <!-- BREAKFAST SECTION -->
    <!-- ========================================== -->
    <div class="card mb-6">
        <div class="card-header bg-linear-to-r from-amber-50 to-orange-50 border-b border-amber-200">
            <div class="flex items-center justify-between">
                <h3 class="card-title text-amber-800">
                    <div class="w-10 h-10 rounded-lg bg-amber-500 text-white flex items-center justify-center mr-3">
                        <i data-lucide="sunrise" class="w-5 h-5"></i>
                    </div>
                    Breakfast Menu
                </h3>
                <span class="badge bg-amber-100 text-amber-700">@breakfastDishes.Count Dishes</span>
            </div>
        </div>
        <div class="card-body">
            @if (breakfastDishes.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    @foreach (var day in daysOfWeek)
                    {
                        var dayDishes = breakfastDishes.Where(d => d.DayOfWeek == day).ToList();
                        <div class="bg-white rounded-xl border border-amber-200 overflow-hidden hover:shadow-md transition-shadow">
                            <!-- Day Header -->
                            <div class="bg-amber-100 px-4 py-2 border-b border-amber-200">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold text-sm">
                                        @day.Substring(0, 2)
                                    </div>
                                    <span class="font-semibold text-amber-800">@day</span>
                                </div>
                            </div>
                            <!-- Dishes -->
                            <div class="p-3">
                                @if (dayDishes.Any())
                                {
                                    <div class="space-y-2">
                                        @foreach (var dish in dayDishes)
                                        {
                                            <div class="flex items-center justify-between p-2 bg-amber-50 rounded-lg group">
                                                <div class="flex-1 min-w-0">
                                                    <p class="font-medium text-gray-900 truncate">@dish.DishName</p>
                                                    <p class="text-sm text-amber-600 font-semibold">Rs. @dish.Price.ToString("N0")</p>
                                                </div>
                                                <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                                    <a asp-action="Edit" asp-route-id="@dish.DishPlanId" class="p-1.5 rounded-lg hover:bg-amber-200 text-amber-700" title="Edit">
                                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@dish.DishPlanId" class="p-1.5 rounded-lg hover:bg-red-100 text-red-600" title="Delete">
                                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-gray-400">
                                        <i data-lucide="plus-circle" class="w-6 h-6 mx-auto mb-1 opacity-50"></i>
                                        <p class="text-xs">No dish</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="sunrise" class="w-12 h-12 mx-auto text-amber-200 mb-2"></i>
                    <p>No breakfast dishes added yet</p>
                    <a asp-action="Create" class="btn btn-sm btn-secondary mt-2">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add Breakfast
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- ========================================== -->
    <!-- LUNCH SECTION -->
    <!-- ========================================== -->
    <div class="card mb-6">
        <div class="card-header bg-linear-to-r from-blue-50 to-cyan-50 border-b border-blue-200">
            <div class="flex items-center justify-between">
                <h3 class="card-title text-blue-800">
                    <div class="w-10 h-10 rounded-lg bg-blue-500 text-white flex items-center justify-center mr-3">
                        <i data-lucide="sun" class="w-5 h-5"></i>
                    </div>
                    Lunch Menu
                </h3>
                <span class="badge bg-blue-100 text-blue-700">@lunchDishes.Count Dishes</span>
            </div>
        </div>
        <div class="card-body">
            @if (lunchDishes.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    @foreach (var day in daysOfWeek)
                    {
                        var dayDishes = lunchDishes.Where(d => d.DayOfWeek == day).ToList();
                        <div class="bg-white rounded-xl border border-blue-200 overflow-hidden hover:shadow-md transition-shadow">
                            <!-- Day Header -->
                            <div class="bg-blue-100 px-4 py-2 border-b border-blue-200">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-blue-500 text-white flex items-center justify-center font-bold text-sm">
                                        @day.Substring(0, 2)
                                    </div>
                                    <span class="font-semibold text-blue-800">@day</span>
                                </div>
                            </div>
                            <!-- Dishes -->
                            <div class="p-3">
                                @if (dayDishes.Any())
                                {
                                    <div class="space-y-2">
                                        @foreach (var dish in dayDishes)
                                        {
                                            <div class="flex items-center justify-between p-2 bg-blue-50 rounded-lg group">
                                                <div class="flex-1 min-w-0">
                                                    <p class="font-medium text-gray-900 truncate">@dish.DishName</p>
                                                    <p class="text-sm text-cyan-600 font-semibold">Rs. @dish.Price.ToString("N0")</p>
                                                </div>
                                                <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                                    <a asp-action="Edit" asp-route-id="@dish.DishPlanId" class="p-1.5 rounded-lg hover:bg-blue-200 text-blue-700" title="Edit">
                                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@dish.DishPlanId" class="p-1.5 rounded-lg hover:bg-red-100 text-red-600" title="Delete">
                                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-gray-400">
                                        <i data-lucide="plus-circle" class="w-6 h-6 mx-auto mb-1 opacity-50"></i>
                                        <p class="text-xs">No dish</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="sun" class="w-12 h-12 mx-auto text-blue-200 mb-2"></i>
                    <p>No lunch dishes added yet</p>
                    <a asp-action="Create" class="btn btn-sm btn-secondary mt-2">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add Lunch
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- ========================================== -->
    <!-- DINNER SECTION -->
    <!-- ========================================== -->
    <div class="card mb-6">
        <div class="card-header bg-linear-to-r from-purple-50 to-indigo-50 border-b border-purple-200">
            <div class="flex items-center justify-between">
                <h3 class="card-title text-purple-800">
                    <div class="w-10 h-10 rounded-lg bg-purple-500 text-white flex items-center justify-center mr-3">
                        <i data-lucide="moon" class="w-5 h-5"></i>
                    </div>
                    Dinner Menu
                </h3>
                <span class="badge bg-purple-100 text-purple-700">@dinnerDishes.Count Dishes</span>
            </div>
        </div>
        <div class="card-body">
            @if (dinnerDishes.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    @foreach (var day in daysOfWeek)
                    {
                        var dayDishes = dinnerDishes.Where(d => d.DayOfWeek == day).ToList();
                        <div class="bg-white rounded-xl border border-purple-200 overflow-hidden hover:shadow-md transition-shadow">
                            <!-- Day Header -->
                            <div class="bg-purple-100 px-4 py-2 border-b border-purple-200">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-purple-500 text-white flex items-center justify-center font-bold text-sm">
                                        @day.Substring(0, 2)
                                    </div>
                                    <span class="font-semibold text-purple-800">@day</span>
                                </div>
                            </div>
                            <!-- Dishes -->
                            <div class="p-3">
                                @if (dayDishes.Any())
                                {
                                    <div class="space-y-2">
                                        @foreach (var dish in dayDishes)
                                        {
                                            <div class="flex items-center justify-between p-2 bg-purple-50 rounded-lg group">
                                                <div class="flex-1 min-w-0">
                                                    <p class="font-medium text-gray-900 truncate">@dish.DishName</p>
                                                    <p class="text-sm text-purple-600 font-semibold">Rs. @dish.Price.ToString("N0")</p>
                                                </div>
                                                <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                                    <a asp-action="Edit" asp-route-id="@dish.DishPlanId" class="p-1.5 rounded-lg hover:bg-purple-200 text-purple-700" title="Edit">
                                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@dish.DishPlanId" class="p-1.5 rounded-lg hover:bg-red-100 text-red-600" title="Delete">
                                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-gray-400">
                                        <i data-lucide="plus-circle" class="w-6 h-6 mx-auto mb-1 opacity-50"></i>
                                        <p class="text-xs">No dish</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <i data-lucide="moon" class="w-12 h-12 mx-auto text-purple-200 mb-2"></i>
                    <p>No dinner dishes added yet</p>
                    <a asp-action="Create" class="btn btn-sm btn-secondary mt-2">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add Dinner
                    </a>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i data-lucide="chef-hat" class="w-16 h-16 text-gray-300"></i>
                </div>
                <h3 class="empty-state-title">No Dishes Added Yet</h3>
                <p class="empty-state-description">Start creating your weekly menu by adding dishes for breakfast, lunch, and dinner.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    Add First Dish
                </a>
            </div>
        </div>
    </div>
}

<!-- Quick Reference -->
<div class="card">
    <div class="card-body">
        <h4 class="font-semibold text-gray-900 mb-3">
            <i data-lucide="info" class="w-4 h-4 inline text-cyan-600"></i>
            Quick Tips
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-gray-600">
            <div class="flex items-start gap-2">
                <i data-lucide="lightbulb" class="w-4 h-4 text-amber-500 mt-0.5"></i>
                <p>Add multiple dishes per day to give variety options for meals.</p>
            </div>
            <div class="flex items-start gap-2">
                <i data-lucide="tag" class="w-4 h-4 text-green-500 mt-0.5"></i>
                <p>Set accurate prices to ensure proper billing for members.</p>
            </div>
            <div class="flex items-start gap-2">
                <i data-lucide="calendar-check" class="w-4 h-4 text-cyan-500 mt-0.5"></i>
                <p>Dishes are linked to attendance for automatic charge calculation.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.initLucideIcons();
    </script>
}
