@model IEnumerable<MessManagement.Models.User>
@{
    ViewData["Title"] = "Members";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-6" role="alert">
        <div class="flex items-start gap-3">
            <i data-lucide="check-circle" class="w-5 h-5 text-green-600 shrink-0"></i>
            <div class="flex-1">
                <p>@TempData["SuccessMessage"]</p>
            </div>
            <button type="button" class="alert-close" onclick="this.closest('.alert').remove()">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-error mb-6" role="alert">
        <div class="flex items-start gap-3">
            <i data-lucide="x-circle" class="w-5 h-5 text-red-600 shrink-0"></i>
            <div class="flex-1">
                <p>@TempData["ErrorMessage"]</p>
            </div>
            <button type="button" class="alert-close" onclick="this.closest('.alert').remove()">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="layout-dashboard" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Members</span>
    </nav>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <i data-lucide="users" class="w-6 h-6"></i>
                </span>
                Members Management
            </h1>
            <p class="page-description">Manage all mess members. Add, edit, or remove users from the system.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            Add New Member
        </a>
    </div>
</div>

<!-- Summary Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    @{
        var totalUsers = Model.Count();
        var adminCount = Model.Count(u => u.Role == "Admin");
        var userCount = Model.Count(u => u.Role == "User");
    }
    <div class="stat-card">
        <div class="stat-icon bg-cyan-100">
            <i data-lucide="users" class="w-6 h-6 text-cyan-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@totalUsers</div>
            <div class="stat-label">Total Members</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-purple-100">
            <i data-lucide="shield" class="w-6 h-6 text-purple-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@adminCount</div>
            <div class="stat-label">Administrators</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-emerald-100">
            <i data-lucide="user" class="w-6 h-6 text-emerald-600"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@userCount</div>
            <div class="stat-label">Regular Users</div>
        </div>
    </div>
</div>

<!-- Members Table -->
<div class="card">
    <div class="card-header">
        <div class="flex items-center justify-between">
            <h3 class="card-title">
                <i data-lucide="list" class="w-5 h-5 text-cyan-600"></i>
                All Members
            </h3>
            <span class="badge badge-primary">@totalUsers Members</span>
        </div>
    </div>
    @if (Model.Any())
    {
        <div class="table-container">
            <table class="data-table" role="grid" aria-label="Members list">
                <thead>
                    <tr>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="user" class="w-4 h-4"></i>
                                Full Name
                            </span>
                        </th>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="at-sign" class="w-4 h-4"></i>
                                Username
                            </span>
                        </th>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="shield" class="w-4 h-4"></i>
                                Role
                            </span>
                        </th>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="phone" class="w-4 h-4"></i>
                                Phone
                            </span>
                        </th>
                        <th scope="col">
                            <span class="flex items-center gap-2">
                                <i data-lucide="mail" class="w-4 h-4"></i>
                                Email
                            </span>
                        </th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-10 h-10 rounded-full flex items-center justify-center text-white font-semibold text-sm @(item.Role == "Admin" ? "bg-linear-to-br from-purple-500 to-purple-600" : "bg-linear-to-br from-cyan-500 to-cyan-600")">
                                        @item.FullName?.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900">@item.FullName</p>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-gray-600">@item.Username</span>
                            </td>
                            <td>
                                @if (item.Role == "Admin")
                                {
                                    <span class="badge badge-info">
                                        <i data-lucide="shield" class="w-3 h-3 mr-1"></i>
                                        Administrator
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-gray">
                                        <i data-lucide="user" class="w-3 h-3 mr-1"></i>
                                        Member
                                    </span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                {
                                    <span class="flex items-center gap-1 text-gray-600">
                                        <i data-lucide="phone" class="w-4 h-4 text-gray-400"></i>
                                        @item.PhoneNumber
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Email))
                                {
                                    <span class="flex items-center gap-1 text-gray-600">
                                        <i data-lucide="mail" class="w-4 h-4 text-gray-400"></i>
                                        @item.Email
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.UserId" class="table-action table-action-view"
                                        aria-label="View details for @item.FullName">
                                        <i data-lucide="eye" class="w-5 h-5 mr-1"></i>
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.UserId" class="table-action table-action-edit"
                                        aria-label="Edit @item.FullName">
                                        <i data-lucide="pencil" class="w-5 h-5 mr-1"></i>
                                        Edit
                                    </a>
                                    @if (item.IsActive)
                                    {
                                        <button type="button" class="table-action table-action-delete flex items-center gap-2"
                                            onclick="showDeactivateModal(@item.UserId, '@item.Username', '@item.FullName')">

                                            <i data-lucide="user-x" class="w-5 h-5 mr-1"></i>
                                            <span>Deactivate</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="table-action table-action-edit flex items-center gap-2"
                                            onclick="showActivateModal(@item.UserId, '@item.FullName')">

                                            <i data-lucide="user-check" class="w-5 h-5 mr-1"></i>
                                            <span>Activate</span>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i data-lucide="users" class="w-16 h-16 text-gray-300"></i>
                </div>
                <h3 class="empty-state-title">No Members Yet</h3>
                <p class="empty-state-description">Get started by adding your first member.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i data-lucide="user-plus" class="w-4 h-4"></i>
                    Add First Member
                </a>
            </div>
        </div>
    }
</div>

<!-- Deactivate Modal -->
<div id="deactivateModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50"
    onclick="hideDeactivateModal(event)">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full mx-4 p-6" onclick="event.stopPropagation()">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
                <i data-lucide="user-x" class="w-5 h-5 text-red-600"></i>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-gray-900">Deactivate Member</h3>
                <p class="text-sm text-gray-500" id="deactivateModalSubtitle">Member will be deactivated</p>
            </div>
        </div>
        <form asp-action="ToggleStatus" method="post" id="deactivateForm" onsubmit="return validateDeactivation()">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deactivateUserId" />
            <input type="hidden" id="deactivateUsername" />

            <div class="mb-4">
                <div class="p-4 bg-red-50 rounded-lg border border-red-200 mb-4">
                    <p class="text-sm text-red-800">
                        <i data-lucide="alert-triangle" class="w-4 h-4 inline mr-1"></i>
                        <strong>Warning:</strong> This member will lose access to the system.
                    </p>
                </div>

                <label class="form-label">Type username to confirm: <span class="text-red-600 font-semibold"
                        id="usernameToConfirm"></span></label>
                <input type="text" id="usernameConfirmInput" class="form-input" placeholder="Enter username to confirm"
                    autocomplete="off" />
                <p class="form-hint text-red-600" id="deactivateError" style="display: none;">Username does not match!
                </p>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" class="btn btn-secondary" onclick="hideDeactivateModal()">Cancel</button>
                <button type="submit" class="btn btn-error">
                    <i data-lucide="user-x" class="w-4 h-4"></i>
                    Deactivate Member
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Activate Modal -->
<div id="activateModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50"
    onclick="hideActivateModal(event)">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full mx-4 p-6" onclick="event.stopPropagation()">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
                <i data-lucide="user-check" class="w-5 h-5 text-green-600"></i>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-gray-900">Activate Member</h3>
                <p class="text-sm text-gray-500" id="activateModalSubtitle">Member will be activated</p>
            </div>
        </div>
        <form asp-action="ToggleStatus" method="post" id="activateForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="activateUserId" />

            <div class="mb-4">
                <div class="p-4 bg-green-50 rounded-lg border border-green-200">
                    <p class="text-sm text-green-800">
                        <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                        This member will regain access to the system and can log in again.
                    </p>
                </div>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" class="btn btn-secondary" onclick="hideActivateModal()">Cancel</button>
                <button type="submit" class="btn btn-success">
                    <i data-lucide="user-check" class="w-4 h-4"></i>
                    Activate Member
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        window.initLucideIcons();
    </script>
}

<script>
    // Deactivate Modal Functions
    function showDeactivateModal(userId, username, fullName) {
        document.getElementById('deactivateUserId').value = userId;
        document.getElementById('deactivateUsername').value = username;
        document.getElementById('usernameToConfirm').textContent = username;
        document.getElementById('deactivateModalSubtitle').textContent = fullName;
        document.getElementById('usernameConfirmInput').value = '';
        document.getElementById('deactivateError').style.display = 'none';
        document.getElementById('deactivateModal').classList.remove('hidden');
        document.getElementById('deactivateModal').classList.add('flex');
        window.initLucideIcons();
    }

    function hideDeactivateModal(event) {
        if (event && event.target !== document.getElementById('deactivateModal')) return;
        document.getElementById('deactivateModal').classList.add('hidden');
        document.getElementById('deactivateModal').classList.remove('flex');
        document.getElementById('usernameConfirmInput').value = '';
        document.getElementById('deactivateError').style.display = 'none';
    }

    function validateDeactivation() {
        const expectedUsername = document.getElementById('deactivateUsername').value;
        const enteredUsername = document.getElementById('usernameConfirmInput').value.trim();
        const errorMsg = document.getElementById('deactivateError');

        if (enteredUsername !== expectedUsername) {
            errorMsg.style.display = 'block';
            document.getElementById('usernameConfirmInput').classList.add('border-red-500');
            return false;
        }
        return true;
    }

    // Activate Modal Functions
    function showActivateModal(userId, fullName) {
        document.getElementById('activateUserId').value = userId;
        document.getElementById('activateModalSubtitle').textContent = fullName;
        document.getElementById('activateModal').classList.remove('hidden');
        document.getElementById('activateModal').classList.add('flex');
        window.initLucideIcons();
    }

    function hideActivateModal(event) {
        if (event && event.target !== document.getElementById('activateModal')) return;
        document.getElementById('activateModal').classList.add('hidden');
        document.getElementById('activateModal').classList.remove('flex');
    }

    // Clear error on input
    document.addEventListener('DOMContentLoaded', function () {
        const usernameInput = document.getElementById('usernameConfirmInput');
        if (usernameInput) {
            usernameInput.addEventListener('input', function () {
                document.getElementById('deactivateError').style.display = 'none';
                this.classList.remove('border-red-500');
            });
        }
    });

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            hideDeactivateModal();
            hideActivateModal();
        }
    });
</script>