@model MessManagement.Models.TeaEntry
@{
    ViewData["Title"] = "Delete Tea Entry";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="layout-dashboard" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Tea")" class="breadcrumb-link">Tea Management</a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Delete</span>
    </nav>
    <h1 class="page-title">
        <span class="page-title-icon bg-linear-to-br from-red-500 to-red-600" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
            <i data-lucide="coffee" class="w-6 h-6"></i>
        </span>
        Delete Tea Entry
    </h1>
</div>

<div class="max-w-2xl">
    <div class="card border-red-200">
        <div class="card-body">
            <!-- Warning Alert -->
            <div class="alert alert-error mb-6">
                <i data-lucide="alert-triangle" class="w-6 h-6 shrink-0"></i>
                <div>
                    <p class="font-semibold">Are you sure you want to delete this tea entry?</p>
                    <p class="text-sm mt-1">This action cannot be undone.</p>
                </div>
            </div>

            <!-- Tea Entry Info Card -->
            <div class="bg-gray-50 rounded-xl p-6 mb-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-14 h-14 rounded-xl bg-amber-500 flex items-center justify-center">
                        <i data-lucide="coffee" class="w-7 h-7 text-white"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold text-gray-900">@Model.Date.ToString("MMMM dd, yyyy")</h3>
                        <p class="text-gray-500">Tea Entry for @Model.User?.FullName</p>
                    </div>
                </div>
                <dl class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <dt class="text-gray-500">Cups</dt>
                        <dd class="font-semibold text-gray-900 text-lg">@Model.Cups</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Period</dt>
                        <dd class="font-medium text-gray-900">@(Model.MessPeriod?.PeriodName ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Verified</dt>
                        <dd class="font-medium text-gray-900">
                            @if (Model.VerifiedByUser)
                            {
                                <span class="badge badge-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge badge-gray">No</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Remarks</dt>
                        <dd class="font-medium text-gray-900">@(Model.Remarks ?? "—")</dd>
                    </div>
                </dl>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="TeaEntryId" />
                <div class="flex justify-end gap-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        Delete Entry
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
