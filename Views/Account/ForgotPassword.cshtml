@model MessManagement.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Reset your MessHub password" />
    <title>Forgot Password - MessHub</title>
    
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <!-- Background Decoration -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-cyan-300/20 blur-3xl"></div>
            <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-teal-300/20 blur-3xl"></div>
        </div>

        <div class="login-card relative">
            <!-- Header -->
            <div class="login-header">
                <div class="login-logo">
                    <i data-lucide="key-round" class="w-10 h-10 text-white"></i>
                </div>
                <h1 class="login-title">Forgot Password?</h1>
                <p class="login-subtitle">Enter your email to receive reset instructions</p>
            </div>

            <!-- Body -->
            <div class="login-body">
                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-error mb-6" role="alert">
                        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                        <div>
                            <p class="font-medium">Please correct the following:</p>
                            <div asp-validation-summary="All" class="text-sm mt-1"></div>
                        </div>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-error mb-6" role="alert">
                        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                        <p>@TempData["ErrorMessage"]</p>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    
                    <!-- Email Field -->
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">
                            <i data-lucide="mail" class="w-4 h-4 inline mr-1"></i>
                            Email Address
                        </label>
                        <div class="relative">
                            <input asp-for="Email" 
                                   type="email"
                                   class="form-input pl-11" 
                                   placeholder="Enter your registered email"
                                   autocomplete="email"
                                   autofocus />
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i data-lucide="mail" class="w-5 h-5 text-gray-400"></i>
                            </div>
                        </div>
                        <span asp-validation-for="Email" class="form-error"></span>
                        <p class="form-hint mt-2">We'll send you a link to reset your password</p>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-full btn-lg mt-6">
                        <i data-lucide="send" class="w-5 h-5"></i>
                        Send Reset Link
                    </button>
                </form>

                <!-- Back to Login -->
                <div class="mt-6 text-center">
                    <a asp-action="Login" class="inline-flex items-center gap-2 text-sm text-cyan-600 hover:text-cyan-700 font-medium transition-colors">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Back to Login
                    </a>
                </div>
            </div>
        </div>

        <!-- Back to Home Link -->
        <div class="mt-6 text-center">
            <a href="@Url.Action("Index", "Home")" data-spa-ignore 
               class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-white/20 hover:bg-white/30 text-white text-sm font-medium transition-all backdrop-blur-sm">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                Back to Home
            </a>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
