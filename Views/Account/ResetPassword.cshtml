@model MessManagement.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Reset your MessHub password" />
    <title>Reset Password - MessHub</title>
    
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <!-- Background Decoration -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-blue-400/20 blur-3xl"></div>
            <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-indigo-400/20 blur-3xl"></div>
        </div>

        <div class="login-card relative">
            <!-- Header -->
            <div class="login-header">
                <div class="login-logo">
                    <i data-lucide="lock-keyhole" class="w-10 h-10 text-white"></i>
                </div>
                <h1 class="login-title">Reset Password</h1>
                <p class="login-subtitle">Create a new secure password</p>
            </div>

            <!-- Body -->
            <div class="login-body">
                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-error mb-6" role="alert">
                        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                        <div>
                            <p class="font-medium">Please correct the following:</p>
                            <div asp-validation-summary="All" class="text-sm mt-1"></div>
                        </div>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-error mb-6" role="alert">
                        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                        <p>@TempData["ErrorMessage"]</p>
                    </div>
                }

                <form asp-action="ResetPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />
                    
                    <!-- New Password Field -->
                    <div class="form-group">
                        <label asp-for="Password" class="form-label">
                            <i data-lucide="lock" class="w-4 h-4 inline mr-1"></i>
                            New Password
                        </label>
                        <div class="relative">
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-input pl-11" 
                                   placeholder="Enter new password"
                                   autocomplete="new-password"
                                   id="password-input"
                                   autofocus />
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i data-lucide="key" class="w-5 h-5 text-gray-400"></i>
                            </div>
                            <button type="button" 
                                    class="absolute inset-y-0 right-0 pr-3 flex items-center"
                                    onclick="togglePassword('password-input', 'eye-icon-1')"
                                    aria-label="Toggle password visibility">
                                <i data-lucide="eye" class="w-5 h-5 text-gray-400 hover:text-gray-600" id="eye-icon-1"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="form-error"></span>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i data-lucide="lock-keyhole" class="w-4 h-4 inline mr-1"></i>
                            Confirm Password
                        </label>
                        <div class="relative">
                            <input asp-for="ConfirmPassword" 
                                   type="password" 
                                   class="form-input pl-11" 
                                   placeholder="Confirm new password"
                                   autocomplete="new-password"
                                   id="confirm-password-input" />
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i data-lucide="key" class="w-5 h-5 text-gray-400"></i>
                            </div>
                            <button type="button" 
                                    class="absolute inset-y-0 right-0 pr-3 flex items-center"
                                    onclick="togglePassword('confirm-password-input', 'eye-icon-2')"
                                    aria-label="Toggle password visibility">
                                <i data-lucide="eye" class="w-5 h-5 text-gray-400 hover:text-gray-600" id="eye-icon-2"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="form-error"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-full btn-lg mt-6">
                        <i data-lucide="check-circle" class="w-5 h-5"></i>
                        Reset Password
                    </button>
                </form>

                <!-- Back to Login -->
                <div class="mt-6 text-center">
                    <a asp-action="Login" class="inline-flex items-center gap-2 text-sm text-blue-600 hover:text-blue-700 font-medium transition-colors">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        lucide.createIcons();
        
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.setAttribute('data-lucide', 'eye-off');
            } else {
                input.type = 'password';
                icon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }
    </script>
</body>
</html>
