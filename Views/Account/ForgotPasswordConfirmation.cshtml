@{
    ViewData["Title"] = "Password Reset Email Sent";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check Your Email - MessHub</title>
    
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <!-- Background Decoration -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-green-400/20 blur-3xl"></div>
            <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
        </div>

        <div class="login-card relative">
            <!-- Header -->
            <div class="login-header" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <div class="w-20 h-20 rounded-full bg-white/20 flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="mail-check" class="w-10 h-10 text-white"></i>
                </div>
                <h1 class="login-title">Check Your Email</h1>
                <p class="login-subtitle">We've sent password reset instructions</p>
            </div>

            <!-- Body -->
            <div class="login-body text-center">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mb-6" role="alert">
                        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
                        <p>@TempData["SuccessMessage"]</p>
                    </div>
                }

                <div class="bg-gray-50 rounded-xl p-6 mb-6">
                    <div class="flex items-center justify-center gap-3 text-gray-600">
                        <i data-lucide="info" class="w-5 h-5 text-cyan-500"></i>
                        <p class="text-sm">
                            If you don't see the email, check your spam folder.
                        </p>
                    </div>
                </div>

                <div class="space-y-3">
                    <a asp-action="Login" class="btn btn-primary w-full">
                        <i data-lucide="log-in" class="w-5 h-5"></i>
                        Back to Login
                    </a>
                    <a asp-action="ForgotPassword" class="btn btn-secondary w-full">
                        <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                        Resend Email
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.initLucideIcons();
    </script>
</body>
</html>
