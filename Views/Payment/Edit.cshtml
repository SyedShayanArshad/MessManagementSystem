@model MessManagement.Models.Payment
@{
    ViewData["Title"] = "Edit Payment";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="home" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Payment")" class="breadcrumb-link">Payments</a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Edit</span>
    </nav>
    <h1 class="page-title">
        <span class="page-title-icon">
            <i data-lucide="receipt" class="w-6 h-6"></i>
        </span>
        Edit Payment
    </h1>
    <p class="page-description">Update payment details and information.</p>
</div>

<div class="max-w-2xl">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i data-lucide="file-edit" class="w-5 h-5 text-blue-600"></i>
                Payment Information
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-error mb-6" role="alert">
                        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                        <div asp-validation-summary="All" class="text-sm"></div>
                    </div>
                }
                <input type="hidden" asp-for="PaymentId" />
                <input type="hidden" asp-for="AttendanceId" />

                <div class="form-group">
                    <label asp-for="UserId" class="form-label">
                        <i data-lucide="user" class="w-4 h-4 inline mr-1"></i>
                        Member <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="UserId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Users, "UserId", "FullName"))">
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="PeriodId" class="form-label">
                        <i data-lucide="calendar-range" class="w-4 h-4 inline mr-1"></i>
                        Mess Period <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="PeriodId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Periods, "PeriodId", "PeriodName"))">
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Amount" class="form-label">
                        <i data-lucide="banknote" class="w-4 h-4 inline mr-1"></i>
                        Amount (PKR) <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">Rs.</span>
                        <input asp-for="Amount" class="form-input pl-12" placeholder="0" step="1" />
                    </div>
                    <span asp-validation-for="Amount" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PaymentMethod" class="form-label">
                        <i data-lucide="credit-card" class="w-4 h-4 inline mr-1"></i>
                        Payment Method <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="Cash">💵 Cash</option>
                        <option value="Bank Transfer">🏦 Bank Transfer</option>
                        <option value="Stripe">💳 Card (Stripe)</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Remarks" class="form-label">
                        <i data-lucide="file-text" class="w-4 h-4 inline mr-1"></i>
                        Remarks
                    </label>
                    <input asp-for="Remarks" class="form-input" placeholder="Optional notes..." />
                </div>

                @if (Model.Attendance != null)
                {
                    <div class="form-group">
                        <label class="form-label">
                            <i data-lucide="link" class="w-4 h-4 inline mr-1"></i>
                            Linked Attendance
                        </label>
                        <div class="p-3 bg-blue-50 rounded-lg border border-blue-200 text-blue-800">
                            <i data-lucide="calendar-check" class="w-4 h-4 inline mr-1"></i>
                            @Model.Attendance.Date.ToShortDateString()
                        </div>
                    </div>
                }

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100 mt-6">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i data-lucide="x" class="w-4 h-4"></i>
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
