@model MessManagement.Models.Payment
@{
    ViewData["Title"] = "Payment Details";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="layout-dashboard" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Payment")" class="breadcrumb-link">Payments</a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Details</span>
    </nav>

    <h1 class="page-title">
        <span class="page-title-icon">
            <i data-lucide="receipt" class="w-6 h-6"></i>
        </span>
        Payment Details
    </h1>
</div>

<!-- CENTER CONTAINER -->
<div class="flex justify-center">
    <div class="w-full max-w-2xl">
        <div class="card">
            <div class="card-body">

                <!-- Payment Header -->
                <div class="flex items-center gap-6 mb-8 pb-6 border-b border-gray-100">
                    <div class="w-20 h-20 rounded-2xl bg-linear-to-br from-emerald-500 to-emerald-600 flex items-center justify-center">
                        <i data-lucide="receipt" class="w-10 h-10 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-3xl font-bold text-gray-900">
                            Rs. @Model.Amount.ToString("N0")
                        </h2>
                        <p class="text-gray-500">@Model.User?.FullName</p>

                        <span class="badge @(Model.PaymentMethod == "Stripe" ? "badge-info" : "badge-success") mt-2">
                            @if (Model.PaymentMethod == "Stripe")
                            {
                                <i data-lucide="wallet" class="w-3 h-3 mr-1"></i>
                            }
                            else
                            {
                                <i data-lucide="banknote" class="w-3 h-3 mr-1"></i>
                            }
                            @Model.PaymentMethod
                        </span>
                    </div>
                </div>

                <!-- PAYMENT DETAILS : 2 ROWS ONLY -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                    <!-- Row 1 - Member -->
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                        <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center">
                            <i data-lucide="user" class="w-5 h-5 text-cyan-600"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Member</p>
                            <p class="font-medium text-gray-900">@Model.User?.FullName</p>
                        </div>
                    </div>

                    <!-- Row 1 - Period -->
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                        <div class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center">
                            <i data-lucide="calendar-range" class="w-5 h-5 text-purple-600"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Mess Period</p>
                            <p class="font-medium text-gray-900">@Model.MessPeriod?.PeriodName</p>
                        </div>
                    </div>

                    <!-- Row 2 - Date -->
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                            <i data-lucide="calendar" class="w-5 h-5 text-emerald-600"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Payment Date</p>
                            <p class="font-medium text-gray-900">
                                @Model.PaymentDate.ToString("MMMM dd, yyyy")
                            </p>
                        </div>
                    </div>

                    <!-- Row 2 - Method -->
                    <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                            <i data-lucide="wallet" class="w-5 h-5 text-amber-600"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Payment Method</p>
                            <p class="font-medium text-gray-900">@Model.PaymentMethod</p>
                        </div>
                    </div>

                </div>

                <!-- Stripe ID -->
                @if (!string.IsNullOrEmpty(Model.StripePaymentId))
                {
                    <div class="mt-4 flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                        <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center">
                            <i data-lucide="hash" class="w-5 h-5 text-indigo-600"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Stripe Payment ID</p>
                            <p class="font-mono text-sm text-gray-900">@Model.StripePaymentId</p>
                        </div>
                    </div>
                }

                <!-- Attendance -->
                @if (Model.Attendance != null)
                {
                    <div class="mt-4 flex items-center gap-4 p-4 bg-cyan-50 rounded-xl border border-cyan-200">
                        <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center">
                            <i data-lucide="link" class="w-5 h-5 text-cyan-600"></i>
                        </div>
                        <div class="flex-1">
                            <p class="text-sm text-cyan-600">Linked Attendance</p>
                            <p class="font-medium text-cyan-900">
                                @Model.Attendance.Date.ToShortDateString()
                            </p>
                        </div>
                        <a asp-controller="Attendance"
                           asp-action="Mark"
                           asp-route-userId="@Model.Attendance.UserId"
                           asp-route-date="@Model.Attendance.Date"
                           class="btn btn-primary btn-sm">
                            View
                        </a>
                    </div>
                }

                <!-- Actions -->
                <div class="flex justify-end gap-3 pt-6 border-t border-gray-100 mt-6">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-primary">
                        <i data-lucide="pencil" class="w-4 h-4"></i>
                        Edit Payment
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
