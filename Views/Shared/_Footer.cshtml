<footer class="app-footer" role="contentinfo">
    <div class="footer-content">
        <div class="flex flex-col md:flex-row justify-between gap-8 items-start">
            <!-- Brand Section -->
            <div class="max-w-sm">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-11 h-11 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);">
                        <i data-lucide="chef-hat" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <div class="footer-logo">MessHub</div>
                        <div class="text-cyan-400 text-xs font-medium uppercase tracking-wider">Smart Dining</div>
                    </div>
                </div>
                <p class="footer-description">
                    A comprehensive mess management solution designed for educational institutions. 
                    Track attendance, manage payments, and plan meals efficiently.
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wider">Quick Links</h4>
                <div class="footer-links flex flex-col gap-2">
                    <a href="@Url.Action("Index", "Home")" class="footer-link">
                        <i data-lucide="layout-dashboard" class="w-4 h-4 inline mr-2"></i>
                        Dashboard
                    </a>
                    @if (User?.IsInRole("Admin") == true)
                    {
                        <a href="@Url.Action("Index", "Report")" class="footer-link">
                            <i data-lucide="pie-chart" class="w-4 h-4 inline mr-2"></i>
                            Reports
                        </a>
                        <a href="@Url.Action("Index", "Users")" class="footer-link">
                            <i data-lucide="users" class="w-4 h-4 inline mr-2"></i>
                            Members
                        </a>
                        <a href="@Url.Action("Index", "Payment")" class="footer-link">
                            <i data-lucide="wallet" class="w-4 h-4 inline mr-2"></i>
                            Payments
                        </a>
                    }
                </div>
            </div>

            <!-- Help Section - HCI: Contextual Help -->
            <div>
                <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wider">Need Help?</h4>
                <div class="footer-links flex flex-col gap-2">
                    <span class="text-gray-400 text-sm flex items-center gap-2">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                        support@messhub.edu
                    </span>
                    <span class="text-gray-400 text-sm flex items-center gap-2">
                        <i data-lucide="phone" class="w-4 h-4"></i>
                        Contact Admin
                    </span>
                </div>
            </div>
        </div>
        
        <!-- Copyright -->
        <div class="border-t border-gray-700 mt-8 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-gray-500 text-sm">
                &copy; @DateTime.Now.Year MessHub - Mess Management System. All rights reserved.
            </p>
            <div class="flex items-center gap-4 text-xs text-gray-500">
                <span class="flex items-center gap-1">
                    <i data-lucide="shield-check" class="w-3 h-3"></i>
                    Secure
                </span>
                <span class="flex items-center gap-1">
                    <i data-lucide="accessibility" class="w-3 h-3"></i>
                    Accessible
                </span>
            </div>
        </div>
    </div>
</footer>
