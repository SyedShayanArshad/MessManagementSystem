@* Partial View: _AttendanceItem.cshtml
   Displays a single attendance row for a user
*@
@model MessManagement.Models.ViewModels.AttendanceItemViewModel

<tr class="attendance-row" data-user-id="@Model.UserId">
    <td class="px-4 py-3">
        <div class="flex items-center gap-3">
            <div class="user-avatar-sm">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>
            <span class="font-medium text-gray-900">@Model.FullName</span>
        </div>
    </td>
    <td class="px-4 py-3 text-center">
        <label class="toggle-switch">
            <input type="checkbox" 
                   class="attendance-toggle" 
                   data-user-id="@Model.UserId"
                   @(Model.IsPresent ? "checked" : "") />
            <span class="toggle-slider"></span>
        </label>
    </td>
    <td class="px-4 py-3">
        <select class="form-select form-select-sm dish-select" data-user-id="@Model.UserId">
            @if (ViewBag.DishPlans != null)
            {
                var dishes = ViewBag.DishPlans as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
                if (dishes != null)
                {
                    foreach (var dish in dishes)
                    {
                        var isSelected = dish.Value == Model.DishPlanId?.ToString();
                        if (isSelected)
                        {
                            <option value="@dish.Value" selected>@dish.Text</option>
                        }
                        else
                        {
                            <option value="@dish.Value">@dish.Text</option>
                        }
                    }
                }
            }
        </select>
    </td>
    <td class="px-4 py-3 text-center">
        @if (Model.AutoChargeExists)
        {
            <span class="badge badge-success">
                <i data-lucide="check" class="w-3 h-3 inline"></i>
                Rs. @Model.AutoChargeAmount?.ToString("N0")
            </span>
        }
        else
        {
            <span class="badge badge-secondary">-</span>
        }
    </td>
    <td class="px-4 py-3 text-center">
        <span class="status-indicator @(Model.IsPresent ? "status-present" : "status-absent")">
            @(Model.IsPresent ? "Present" : "Absent")
        </span>
    </td>
</tr>
