@* Partial View: _StatsCard.cshtml
   Usage: @await Html.PartialAsync("_StatsCard", new StatsCardViewModel { ... })
   or via fetch/AJAX loading
*@
@model MessManagement.Models.ViewModels.StatsCardViewModel

<div class="dashboard-card" id="stats-card-@Model.Id">
    <div class="dashboard-card-icon @Model.IconClass">
        <i data-lucide="@Model.Icon" class="w-7 h-7"></i>
    </div>
    <div class="dashboard-card-title">@Model.Title</div>
    <div class="dashboard-card-value" id="stats-value-@Model.Id">@Model.Value</div>
    <div class="dashboard-card-description">
        <span class="@Model.DescriptionClass">@Model.Description</span>
    </div>
</div>
