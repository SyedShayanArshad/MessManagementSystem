@{
    ViewData["Title"] = "Monthly Report";
}

<!-- Toast/Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="alert">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-error mb-4" role="alert">
        <i data-lucide="alert-circle" class="w-5 h-5"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning mb-4" role="alert">
        <i data-lucide="alert-triangle" class="w-5 h-5"></i>
        <span>@TempData["WarningMessage"]</span>
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="layout-dashboard" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Reports</span>
    </nav>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <i data-lucide="bar-chart-3" class="w-6 h-6"></i>
                </span>
                Monthly Reports
            </h1>
            <p class="page-description">Generate and view comprehensive reports for any billing period.</p>
        </div>
    </div>
</div>

<!-- Period Selection Card -->
<div class="card mb-6">
    <div class="card-header">
        <h3 class="card-title">
            <i data-lucide="calendar-range" class="w-5 h-5 text-cyan-600"></i>
            Select Report Period
        </h3>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="flex flex-col md:flex-row gap-4 items-end">
            <div class="flex-1">
                <label class="form-label">
                    <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>
                    Billing Period
                </label>
                <select name="periodId" class="form-select" aria-label="Select billing period">
                    <option value="">-- Select Period --</option>
                    @foreach (var p in (IEnumerable<MessManagement.Models.MessPeriod>)ViewBag.Periods)
                    {
                        <option value="@p.PeriodId" selected="@(ViewBag.SelectedPeriod != null && ((MessManagement.Models.MessPeriod)ViewBag.SelectedPeriod).PeriodId == p.PeriodId)">
                            @p.PeriodName
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">
                <i data-lucide="file-search" class="w-4 h-4"></i>
                Generate Report
            </button>
        </form>
    </div>
</div>

@if (ViewBag.Report != null)
{
    var rList = (List<object>)ViewBag.Report;
    var selectedPeriod = (MessManagement.Models.MessPeriod)ViewBag.SelectedPeriod;
    
    // Calculate summary stats
    var totalCharges = rList.Sum(x => (decimal)((dynamic)x).TotalCharges);
    var totalMealCharges = rList.Sum(x => (decimal)((dynamic)x).MealCharges);
    var totalWaterCharges = rList.Sum(x => (decimal)((dynamic)x).WaterCharges);
    var totalTeaCharges = rList.Sum(x => (decimal)((dynamic)x).TeaCharges);
    var totalPaid = rList.Sum(x => (decimal)((dynamic)x).Payments);
    var totalBalance = rList.Sum(x => (decimal)((dynamic)x).Balance);
    var membersWithDues = rList.Count(x => (decimal)((dynamic)x).Balance > 0);
    var fullyPaidMembers = rList.Count - membersWithDues;
    var collectionRate = totalCharges > 0 ? (totalPaid / totalCharges * 100) : 0;
    var totalBreakfast = rList.Sum(x => (int)((dynamic)x).BreakfastCount);
    var totalLunch = rList.Sum(x => (int)((dynamic)x).LunchCount);
    var totalDinner = rList.Sum(x => (int)((dynamic)x).DinnerCount);
    var totalTeaCups = rList.Sum(x => (int)((dynamic)x).TeaCups);

    <!-- ============================================== -->
    <!-- SECTION 1: PERIOD INFO & COLLECTION PROGRESS -->
    <!-- ============================================== -->
    <div class="card mb-6">
        <div class="card-body">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <!-- Period Info -->
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl bg-linear-to-br from-cyan-500 to-teal-600 flex items-center justify-center shadow-lg">
                        <i data-lucide="calendar-range" class="w-8 h-8 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900">@selectedPeriod.PeriodName</h2>
                        <p class="text-gray-500">@selectedPeriod.StartDate.ToString("MMM dd") - @selectedPeriod.EndDate.ToString("MMM dd, yyyy")</p>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="badge @(selectedPeriod.IsActive ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                @(selectedPeriod.IsActive ? "Active" : "Closed")
                            </span>
                            <span class="badge bg-cyan-100 text-cyan-700">@rList.Count Members</span>
                        </div>
                    </div>
                </div>
                
                <!-- Collection Progress -->
                <div class="flex-1 max-w-md">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-medium text-gray-600">Collection Progress</span>
                        <span class="text-lg font-bold @(collectionRate >= 100 ? "text-green-600" : collectionRate >= 75 ? "text-cyan-600" : collectionRate >= 50 ? "text-amber-600" : "text-red-600")">
                            @collectionRate.ToString("N1")%
                        </span>
                    </div>
                    <div class="w-full h-4 bg-gray-200 rounded-full overflow-hidden">
                        <div class="h-full rounded-full transition-all duration-500 @(collectionRate >= 100 ? "bg-linear-to-r from-green-400 to-green-600" : collectionRate >= 75 ? "bg-linear-to-r from-cyan-400 to-cyan-600" : collectionRate >= 50 ? "bg-linear-to-r from-amber-400 to-amber-600" : "bg-linear-to-r from-red-400 to-red-600")"
                             style="width: @Math.Min(collectionRate, 100)%"></div>
                    </div>
                    <div class="flex items-center justify-between mt-2 text-xs text-gray-500">
                        <span>Rs. @totalPaid.ToString("N0") collected</span>
                        <span>Rs. @totalCharges.ToString("N0") total</span>
                    </div>
                </div>
                
                <!-- Export Buttons -->
                <div class="flex flex-col gap-2">
                    <a href="@Url.Action("ExportSummaryCsv", new { periodId = selectedPeriod.PeriodId })" 
                       class="btn btn-secondary text-sm" target="_blank">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                        Export Summary CSV
                    </a>
                    <a href="@Url.Action("ExportSummaryPdf", new { periodId = selectedPeriod.PeriodId })" 
                       class="btn btn-secondary text-sm" target="_blank">
                        <i data-lucide="file-text" class="w-4 h-4"></i>
                        Export Summary PDF
                    </a>
                    <a href="@Url.Action("ExportUserDetailCsv", new { periodId = selectedPeriod.PeriodId })" 
                       class="btn btn-outline text-sm" target="_blank">
                        <i data-lucide="users" class="w-4 h-4"></i>
                        Export All Users CSV
                    </a>
                    <a href="@Url.Action("ExportUserDetailPdf", new { periodId = selectedPeriod.PeriodId })" 
                       class="btn btn-outline text-sm" target="_blank">
                        <i data-lucide="users" class="w-4 h-4"></i>
                        Export All Users PDF
                    </a>
                    <button type="button" class="btn btn-primary text-sm w-full"
                            onclick="openEmailAllModal()">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                        Email All Bills
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- SECTION 2: DASHBOARD STATS -->
    <!-- ============================================== -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
        <!-- Total Meal Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon warning">
                <i data-lucide="utensils" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Meal Charges</div>
            <div class="dashboard-card-value text-xl text-amber-600">Rs. @totalMealCharges.ToString("N0")</div>
            <div class="dashboard-card-description">@totalBreakfast B / @totalLunch L / @totalDinner D</div>
        </div>
        
        <!-- Tea Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon" style="background: linear-gradient(135deg, #fb923c, #f97316);">
                <i data-lucide="coffee" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Tea Charges</div>
            <div class="dashboard-card-value text-xl text-orange-600">Rs. @totalTeaCharges.ToString("N0")</div>
            <div class="dashboard-card-description">@totalTeaCups cups served</div>
        </div>
        
        <!-- Water Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon" style="background: linear-gradient(135deg, #22d3ee, #06b6d4);">
                <i data-lucide="droplets" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Water Charges</div>
            <div class="dashboard-card-value text-xl text-cyan-600">Rs. @totalWaterCharges.ToString("N0")</div>
            <div class="dashboard-card-description">Rs. @selectedPeriod.FixedWaterCharge/member</div>
        </div>
        
        <!-- Total Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon primary">
                <i data-lucide="receipt" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Grand Total</div>
            <div class="dashboard-card-value text-xl">Rs. @totalCharges.ToString("N0")</div>
            <div class="dashboard-card-description">All charges combined</div>
        </div>
        
        <!-- Total Collected -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon success">
                <i data-lucide="wallet" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Total Collected</div>
            <div class="dashboard-card-value text-xl text-green-600">Rs. @totalPaid.ToString("N0")</div>
            <div class="dashboard-card-description">@fullyPaidMembers fully paid</div>
        </div>
        
        <!-- Outstanding Balance -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon @(totalBalance > 0 ? "danger" : "success")">
                <i data-lucide="@(totalBalance > 0 ? "alert-circle" : "check-circle")" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Outstanding</div>
            <div class="dashboard-card-value text-xl @(totalBalance > 0 ? "text-red-600" : "text-green-600")">Rs. @totalBalance.ToString("N0")</div>
            <div class="dashboard-card-description">@membersWithDues members pending</div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- SECTION 3: FILTER TABS & MEMBER TABLE -->
    <!-- ============================================== -->
    <div class="card" x-data="{ filter: 'all', search: '' }">
        <div class="card-header border-b-0 pb-0">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <h3 class="card-title">
                    <i data-lucide="table" class="w-5 h-5 text-cyan-600"></i>
                    Member-wise Report
                </h3>
                
                <!-- Filter Tabs -->
                <div class="flex items-center gap-2">
                    <button @@click="filter = 'all'" 
                            :class="filter === 'all' ? 'bg-cyan-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        All (@rList.Count)
                    </button>
                    <button @@click="filter = 'dues'" 
                            :class="filter === 'dues' ? 'bg-red-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i data-lucide="alert-circle" class="w-4 h-4 inline"></i>
                        With Dues (@membersWithDues)
                    </button>
                    <button @@click="filter = 'paid'" 
                            :class="filter === 'paid' ? 'bg-green-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i data-lucide="check-circle" class="w-4 h-4 inline"></i>
                        Fully Paid (@fullyPaidMembers)
                    </button>
                </div>
            </div>
            
            <!-- Search -->
            <div class="mt-4 relative">
                <i data-lucide="search" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input type="text" x-model="search" placeholder="Search by name..." 
                       class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
            </div>
        </div>
        
        @if (rList.Any())
        {
            <div class="table-container">
                <table class="data-table" role="grid" aria-label="Monthly report data">
                    <thead>
                        <tr>
                            <th scope="col" class="min-w-[200px]">
                                <span class="flex items-center gap-2">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                    Member
                                </span>
                            </th>
                            <th scope="col" class="text-center bg-amber-50/50">
                                <span class="text-amber-700">B</span>
                            </th>
                            <th scope="col" class="text-center bg-cyan-50/50">
                                <span class="text-cyan-700">L</span>
                            </th>
                            <th scope="col" class="text-center bg-purple-50/50">
                                <span class="text-purple-700">D</span>
                            </th>
                            <th scope="col" class="text-right">Meals</th>
                            <th scope="col" class="text-center bg-orange-50/50">
                                <span class="text-orange-700">Tea</span>
                            </th>
                            <th scope="col" class="text-center bg-cyan-50/50">
                                <span class="text-cyan-700">Water</span>
                            </th>
                            <th scope="col" class="text-right">Total</th>
                            <th scope="col" class="text-right">Paid</th>
                            <th scope="col" class="text-right">Balance</th>
                            <th scope="col" class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowIndex = 0; }
                        @foreach (dynamic item in rList)
                        {
                            var balance = (decimal)item.Balance;
                            var hasDues = balance > 0;
                            var filterClass = hasDues ? "has-dues" : "fully-paid";
                            var userName = (string)item.User.FullName;
                            <tr class="@filterClass hover:bg-cyan-50/50 transition-colors cursor-pointer"
                                x-show="(filter === 'all' || (filter === 'dues' && @(hasDues ? "true" : "false")) || (filter === 'paid' && @(!hasDues ? "true" : "false"))) && ($el.dataset.name.toLowerCase().includes(search.toLowerCase()))"
                                data-name="@userName"
                                onclick="window.location.href='@Url.Action("MemberDetail", "Payment", new { userId = item.User.UserId, periodId = selectedPeriod.PeriodId })'">
                                <td>
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-linear-to-br from-cyan-500 to-cyan-600 flex items-center justify-center text-white font-semibold text-sm shadow-sm">
                                            @userName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <p class="font-medium text-gray-900">@userName</p>
                                            <p class="text-xs text-gray-500">@@@item.User.Username</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center bg-amber-50/30">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-amber-100 text-amber-700 font-semibold text-sm">
                                        @item.BreakfastCount
                                    </span>
                                </td>
                                <td class="text-center bg-cyan-50/30">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-cyan-100 text-cyan-700 font-semibold text-sm">
                                        @item.LunchCount
                                    </span>
                                </td>
                                <td class="text-center bg-purple-50/30">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-purple-100 text-purple-700 font-semibold text-sm">
                                        @item.DinnerCount
                                    </span>
                                </td>
                                <td class="text-right">
                                    <span class="font-medium">Rs. @(((decimal)item.MealCharges).ToString("N0"))</span>
                                </td>
                                <td class="text-center bg-orange-50/30">
                                    <div class="flex flex-col items-center">
                                        <span class="text-xs text-gray-500">@item.TeaCups cups</span>
                                        <span class="font-medium text-orange-600">Rs. @(((decimal)item.TeaCharges).ToString("N0"))</span>
                                    </div>
                                </td>
                                <td class="text-center bg-cyan-50/30">
                                    <span class="font-medium text-cyan-600">Rs. @(((decimal)item.WaterCharges).ToString("N0"))</span>
                                </td>
                                <td class="text-right">
                                    <span class="font-semibold text-gray-900">Rs. @(((decimal)item.TotalCharges).ToString("N0"))</span>
                                </td>
                                <td class="text-right">
                                    <span class="font-semibold text-green-600">Rs. @(((decimal)item.Payments).ToString("N0"))</span>
                                </td>
                                <td class="text-right px-4">
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold @(hasDues ? "bg-red-100 text-red-700 border border-red-200" : "bg-green-100 text-green-700 border border-green-200")">
                                        @(hasDues ? "Due" : "Paid") Rs. @Math.Abs(balance).ToString("N0")
                                    </span>
                                </td>
                                <td class="text-center px-4 no-print" onclick="event.stopPropagation()">
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="@Url.Action("MemberDetail", "Payment", new { userId = item.User.UserId, periodId = selectedPeriod.PeriodId })" 
                                           class="p-2 rounded-lg hover:bg-cyan-100 text-cyan-600 transition-colors" title="View Details">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </a>
                                        <a href="@Url.Action("ExportUserDetailCsv", new { periodId = selectedPeriod.PeriodId, userId = item.User.UserId })" 
                                           class="p-2 rounded-lg hover:bg-green-100 text-green-600 transition-colors" title="Export User CSV" target="_blank">
                                            <i data-lucide="download" class="w-4 h-4"></i>
                                        </a>
                                        <a href="@Url.Action("ExportUserDetailPdf", new { periodId = selectedPeriod.PeriodId, userId = item.User.UserId })" 
                                           class="p-2 rounded-lg hover:bg-red-100 text-red-600 transition-colors" title="Export User PDF" target="_blank">
                                            <i data-lucide="file-text" class="w-4 h-4"></i>
                                        </a>
                                        @if (!string.IsNullOrEmpty((string?)item.User.Email))
                                        {
                                            <button type="button" 
                                                    class="p-2 rounded-lg hover:bg-blue-100 text-blue-600 transition-colors" 
                                                    title="Email Bill Statement"
                                                    onclick="event.stopPropagation(); openEmailUserModal(@item.User.UserId, '@item.User.FullName.Replace("'", "\'")', '@item.User.Email');">
                                                <i data-lucide="mail" class="w-4 h-4"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="p-2 rounded-lg text-gray-300 cursor-not-allowed" title="No email configured">
                                                <i data-lucide="mail-x" class="w-4 h-4"></i>
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-50">
                        <tr class="font-semibold">
                            <td class="px-4 py-3">
                                <span class="text-gray-900">Total (@rList.Count members)</span>
                            </td>
                            <td class="text-center bg-amber-50/50">
                                <span class="text-amber-700">@totalBreakfast</span>
                            </td>
                            <td class="text-center bg-blue-50/50">
                                <span class="text-blue-700">@totalLunch</span>
                            </td>
                            <td class="text-center bg-purple-50/50">
                                <span class="text-purple-700">@totalDinner</span>
                            </td>
                            <td class="text-right">Rs. @totalMealCharges.ToString("N0")</td>
                            <td class="text-center bg-orange-50/50">
                                <span class="text-orange-700">Rs. @totalTeaCharges.ToString("N0")</span>
                            </td>
                            <td class="text-center bg-cyan-50/50">
                                <span class="text-cyan-700">Rs. @totalWaterCharges.ToString("N0")</span>
                            </td>
                            <td class="text-right">Rs. @totalCharges.ToString("N0")</td>
                            <td class="text-right text-green-600">Rs. @totalPaid.ToString("N0")</td>
                            <td class="text-right @(totalBalance > 0 ? "text-red-600" : "text-green-600")">Rs. @totalBalance.ToString("N0")</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i data-lucide="file-x" class="w-16 h-16 text-gray-300"></i>
                    </div>
                    <h3 class="empty-state-title">No Data Available</h3>
                    <p class="empty-state-description">There are no records for the selected period.</p>
                </div>
            </div>
        }
        <div class="card-footer flex flex-col sm:flex-row justify-between items-center gap-4 no-print">
            <p class="text-sm text-gray-500">
                <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                Report generated on @DateTime.Now.ToString("MMMM dd, yyyy HH:mm")
            </p>
        </div>
    </div>
}
else
{
    <!-- No Report Selected -->
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <div class="w-20 h-20 mx-auto rounded-2xl bg-linear-to-br from-cyan-100 to-cyan-200 flex items-center justify-center mb-4">
                    <i data-lucide="file-search" class="w-10 h-10 text-cyan-600"></i>
                </div>
                <h3 class="empty-state-title">Select a Period</h3>
                <p class="empty-state-description">Choose a billing period above to generate the monthly report.</p>
            </div>
        </div>
    </div>
}

<!-- Email All Bills Modal -->
@if (ViewBag.SelectedPeriod != null)
{
    var sp = (MessManagement.Models.MessPeriod)ViewBag.SelectedPeriod;
    <div id="emailAllModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
            <!-- Background overlay -->
            <div class="fixed inset-0 bg-gray-500/75 transition-opacity" onclick="closeEmailAllModal()"></div>
            
            <!-- Modal panel -->
            <div class="relative inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-xl rounded-2xl">
                <div class="absolute top-4 right-4">
                    <button type="button" onclick="closeEmailAllModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>
                
                <div class="flex items-center gap-4 mb-6">
                    <div class="flex-shrink-0 w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
                        <i data-lucide="mail" class="w-6 h-6 text-blue-600"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900" id="modal-title">Email All Bill Statements</h3>
                        <p class="text-sm text-gray-500">@sp.PeriodName</p>
                    </div>
                </div>
                
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                    <div class="flex items-start gap-3">
                        <i data-lucide="info" class="w-5 h-5 text-blue-600 mt-0.5"></i>
                        <div class="text-sm text-blue-800">
                            <p class="font-medium mb-1">This will send emails to all members with configured email addresses.</p>
                            <p>Each email will include:</p>
                            <ul class="list-disc list-inside mt-2 space-y-1 text-blue-700">
                                <li>Detailed bill breakdown (meals, tea, water)</li>
                                <li>Payment summary and balance due</li>
                                <li>PDF attachment of the bill statement</li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <form asp-action="SendBillStatementEmails" method="post">
                    <input type="hidden" name="periodId" value="@sp.PeriodId" />
                    <div class="flex gap-3 justify-end">
                        <button type="button" onclick="closeEmailAllModal()" class="btn btn-secondary">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary" id="emailAllSubmitBtn">
                            <i data-lucide="send" class="w-4 h-4"></i>
                            Send to All Members
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Email Single User Modal -->
    <div id="emailUserModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title-user" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
            <!-- Background overlay -->
            <div class="fixed inset-0 bg-gray-500/75 transition-opacity" onclick="closeEmailUserModal()"></div>
            
            <!-- Modal panel -->
            <div class="relative inline-block w-full max-w-md p-6 my-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-xl rounded-2xl">
                <div class="absolute top-4 right-4">
                    <button type="button" onclick="closeEmailUserModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>
                
                <div class="flex items-center gap-4 mb-6">
                    <div class="flex-shrink-0 w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
                        <i data-lucide="mail" class="w-6 h-6 text-green-600"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900" id="modal-title-user">Send Bill Statement</h3>
                        <p class="text-sm text-gray-500">@sp.PeriodName</p>
                    </div>
                </div>
                
                <div class="bg-gray-50 rounded-lg p-4 mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-cyan-500 flex items-center justify-center text-white font-semibold" id="userInitial">?</div>
                        <div>
                            <p class="font-medium text-gray-900" id="userFullName">-</p>
                            <p class="text-sm text-gray-500" id="userEmail">-</p>
                        </div>
                    </div>
                </div>
                
                <p class="text-sm text-gray-600 mb-6">
                    <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                    This will send a detailed bill statement with PDF attachment to this member.
                </p>
                
                <form asp-action="SendBillStatementEmail" method="post">
                    <input type="hidden" name="periodId" value="@sp.PeriodId" />
                    <input type="hidden" name="userId" id="emailUserId" value="" />
                    <div class="flex gap-3 justify-end">
                        <button type="button" onclick="closeEmailUserModal()" class="btn btn-secondary">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary" id="emailUserSubmitBtn">
                            <i data-lucide="send" class="w-4 h-4"></i>
                            Send Email
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        window.initLucideIcons();
        
        // Email All Modal Functions
        function openEmailAllModal() {
            document.getElementById('emailAllModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            setTimeout(() => window.initLucideIcons(), 50);
        }
        
        function closeEmailAllModal() {
            document.getElementById('emailAllModal').classList.add('hidden');
            document.body.style.overflow = '';
        }
        
        // Email Single User Modal Functions
        function openEmailUserModal(userId, fullName, email) {
            document.getElementById('emailUserId').value = userId;
            document.getElementById('userFullName').textContent = fullName;
            document.getElementById('userEmail').textContent = email;
            document.getElementById('userInitial').textContent = fullName.charAt(0).toUpperCase();
            document.getElementById('emailUserModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            setTimeout(() => window.initLucideIcons(), 50);
        }
        
        function closeEmailUserModal() {
            document.getElementById('emailUserModal').classList.add('hidden');
            document.body.style.overflow = '';
        }
        
        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeEmailAllModal();
                closeEmailUserModal();
            }
        });
        
        // Add loading state on form submit
        document.querySelectorAll('#emailAllModal form, #emailUserModal form').forEach(form => {
            form.addEventListener('submit', function() {
                const btn = this.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<svg class="animate-spin w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Sending...';
            });
        });
    </script>
}
