@{
    ViewData["Title"] = "Monthly Report";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb-item">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">
                <i data-lucide="home" class="w-4 h-4 inline"></i>
                Dashboard
            </a>
        </span>
        <span class="breadcrumb-separator">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </span>
        <span class="breadcrumb-item text-gray-900 font-medium">Reports</span>
    </nav>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="page-title">
                <span class="page-title-icon">
                    <i data-lucide="bar-chart-3" class="w-6 h-6"></i>
                </span>
                Monthly Reports
            </h1>
            <p class="page-description">Generate and view comprehensive reports for any billing period.</p>
        </div>
    </div>
</div>

<!-- Period Selection Card -->
<div class="card mb-6">
    <div class="card-header">
        <h3 class="card-title">
            <i data-lucide="calendar-range" class="w-5 h-5 text-blue-600"></i>
            Select Report Period
        </h3>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="flex flex-col md:flex-row gap-4 items-end">
            <div class="flex-1">
                <label class="form-label">
                    <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>
                    Billing Period
                </label>
                <select name="periodId" class="form-select" aria-label="Select billing period">
                    <option value="">-- Select Period --</option>
                    @foreach (var p in (IEnumerable<MessManagement.Models.MessPeriod>)ViewBag.Periods)
                    {
                        <option value="@p.PeriodId" selected="@(ViewBag.SelectedPeriod != null && ((MessManagement.Models.MessPeriod)ViewBag.SelectedPeriod).PeriodId == p.PeriodId)">
                            @p.PeriodName
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">
                <i data-lucide="file-search" class="w-4 h-4"></i>
                Generate Report
            </button>
        </form>
    </div>
</div>

@if (ViewBag.Report != null)
{
    var rList = (List<object>)ViewBag.Report;
    var selectedPeriod = (MessManagement.Models.MessPeriod)ViewBag.SelectedPeriod;
    
    // Calculate summary stats
    var totalCharges = rList.Sum(x => (decimal)((dynamic)x).TotalCharges);
    var totalMealCharges = rList.Sum(x => (decimal)((dynamic)x).MealCharges);
    var totalWaterCharges = rList.Sum(x => (decimal)((dynamic)x).WaterCharges);
    var totalTeaCharges = rList.Sum(x => (decimal)((dynamic)x).TeaCharges);
    var totalPaid = rList.Sum(x => (decimal)((dynamic)x).Payments);
    var totalBalance = rList.Sum(x => (decimal)((dynamic)x).Balance);
    var membersWithDues = rList.Count(x => (decimal)((dynamic)x).Balance > 0);
    var fullyPaidMembers = rList.Count - membersWithDues;
    var collectionRate = totalCharges > 0 ? (totalPaid / totalCharges * 100) : 0;
    var totalBreakfast = rList.Sum(x => (int)((dynamic)x).BreakfastCount);
    var totalLunch = rList.Sum(x => (int)((dynamic)x).LunchCount);
    var totalDinner = rList.Sum(x => (int)((dynamic)x).DinnerCount);
    var totalTeaCups = rList.Sum(x => (int)((dynamic)x).TeaCups);

    <!-- ============================================== -->
    <!-- SECTION 1: PERIOD INFO & COLLECTION PROGRESS -->
    <!-- ============================================== -->
    <div class="card mb-6">
        <div class="card-body">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <!-- Period Info -->
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-lg">
                        <i data-lucide="calendar-range" class="w-8 h-8 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900">@selectedPeriod.PeriodName</h2>
                        <p class="text-gray-500">@selectedPeriod.StartDate.ToString("MMM dd") - @selectedPeriod.EndDate.ToString("MMM dd, yyyy")</p>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="badge @(selectedPeriod.IsActive ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                @(selectedPeriod.IsActive ? "Active" : "Closed")
                            </span>
                            <span class="badge bg-blue-100 text-blue-700">@rList.Count Members</span>
                        </div>
                    </div>
                </div>
                
                <!-- Collection Progress -->
                <div class="flex-1 max-w-md">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-medium text-gray-600">Collection Progress</span>
                        <span class="text-lg font-bold @(collectionRate >= 100 ? "text-green-600" : collectionRate >= 75 ? "text-blue-600" : collectionRate >= 50 ? "text-amber-600" : "text-red-600")">
                            @collectionRate.ToString("N1")%
                        </span>
                    </div>
                    <div class="w-full h-4 bg-gray-200 rounded-full overflow-hidden">
                        <div class="h-full rounded-full transition-all duration-500 @(collectionRate >= 100 ? "bg-gradient-to-r from-green-400 to-green-600" : collectionRate >= 75 ? "bg-gradient-to-r from-blue-400 to-blue-600" : collectionRate >= 50 ? "bg-gradient-to-r from-amber-400 to-amber-600" : "bg-gradient-to-r from-red-400 to-red-600")"
                             style="width: @Math.Min(collectionRate, 100)%"></div>
                    </div>
                    <div class="flex items-center justify-between mt-2 text-xs text-gray-500">
                        <span>Rs. @totalPaid.ToString("N0") collected</span>
                        <span>Rs. @totalCharges.ToString("N0") total</span>
                    </div>
                </div>
                
                <!-- Export Buttons -->
                <div class="flex flex-col gap-2">
                    <a href="@Url.Action("ExportSummary", new { periodId = selectedPeriod.PeriodId })" 
                       class="btn btn-secondary text-sm">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                        Export Summary
                    </a>
                    <a href="@Url.Action("ExportUserDetail", new { periodId = selectedPeriod.PeriodId })" 
                       class="btn btn-outline text-sm">
                        <i data-lucide="users" class="w-4 h-4"></i>
                        Export All Users
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- SECTION 2: DASHBOARD STATS -->
    <!-- ============================================== -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
        <!-- Total Meal Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon warning">
                <i data-lucide="utensils" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Meal Charges</div>
            <div class="dashboard-card-value text-xl text-amber-600">Rs. @totalMealCharges.ToString("N0")</div>
            <div class="dashboard-card-description">@totalBreakfast B / @totalLunch L / @totalDinner D</div>
        </div>
        
        <!-- Tea Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon" style="background: linear-gradient(135deg, #fb923c, #f97316);">
                <i data-lucide="coffee" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Tea Charges</div>
            <div class="dashboard-card-value text-xl text-orange-600">Rs. @totalTeaCharges.ToString("N0")</div>
            <div class="dashboard-card-description">@totalTeaCups cups served</div>
        </div>
        
        <!-- Water Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon" style="background: linear-gradient(135deg, #22d3ee, #06b6d4);">
                <i data-lucide="droplets" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Water Charges</div>
            <div class="dashboard-card-value text-xl text-cyan-600">Rs. @totalWaterCharges.ToString("N0")</div>
            <div class="dashboard-card-description">Rs. @selectedPeriod.FixedWaterCharge/member</div>
        </div>
        
        <!-- Total Charges -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon primary">
                <i data-lucide="receipt" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Grand Total</div>
            <div class="dashboard-card-value text-xl">Rs. @totalCharges.ToString("N0")</div>
            <div class="dashboard-card-description">All charges combined</div>
        </div>
        
        <!-- Total Collected -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon success">
                <i data-lucide="wallet" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Total Collected</div>
            <div class="dashboard-card-value text-xl text-green-600">Rs. @totalPaid.ToString("N0")</div>
            <div class="dashboard-card-description">@fullyPaidMembers fully paid</div>
        </div>
        
        <!-- Outstanding Balance -->
        <div class="dashboard-card">
            <div class="dashboard-card-icon @(totalBalance > 0 ? "danger" : "success")">
                <i data-lucide="@(totalBalance > 0 ? "alert-circle" : "check-circle")" class="w-7 h-7"></i>
            </div>
            <div class="dashboard-card-title">Outstanding</div>
            <div class="dashboard-card-value text-xl @(totalBalance > 0 ? "text-red-600" : "text-green-600")">Rs. @totalBalance.ToString("N0")</div>
            <div class="dashboard-card-description">@membersWithDues members pending</div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- SECTION 3: FILTER TABS & MEMBER TABLE -->
    <!-- ============================================== -->
    <div class="card" x-data="{ filter: 'all', search: '' }">
        <div class="card-header border-b-0 pb-0">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <h3 class="card-title">
                    <i data-lucide="table" class="w-5 h-5 text-blue-600"></i>
                    Member-wise Report
                </h3>
                
                <!-- Filter Tabs -->
                <div class="flex items-center gap-2">
                    <button @@click="filter = 'all'" 
                            :class="filter === 'all' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        All (@rList.Count)
                    </button>
                    <button @@click="filter = 'dues'" 
                            :class="filter === 'dues' ? 'bg-red-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i data-lucide="alert-circle" class="w-4 h-4 inline"></i>
                        With Dues (@membersWithDues)
                    </button>
                    <button @@click="filter = 'paid'" 
                            :class="filter === 'paid' ? 'bg-green-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
                            class="px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i data-lucide="check-circle" class="w-4 h-4 inline"></i>
                        Fully Paid (@fullyPaidMembers)
                    </button>
                </div>
            </div>
            
            <!-- Search -->
            <div class="mt-4 relative">
                <i data-lucide="search" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input type="text" x-model="search" placeholder="Search by name..." 
                       class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            </div>
        </div>
        
        @if (rList.Any())
        {
            <div class="table-container">
                <table class="data-table" role="grid" aria-label="Monthly report data">
                    <thead>
                        <tr>
                            <th scope="col" class="min-w-[200px]">
                                <span class="flex items-center gap-2">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                    Member
                                </span>
                            </th>
                            <th scope="col" class="text-center bg-amber-50/50">
                                <span class="text-amber-700">B</span>
                            </th>
                            <th scope="col" class="text-center bg-blue-50/50">
                                <span class="text-blue-700">L</span>
                            </th>
                            <th scope="col" class="text-center bg-purple-50/50">
                                <span class="text-purple-700">D</span>
                            </th>
                            <th scope="col" class="text-right">Meals</th>
                            <th scope="col" class="text-center bg-orange-50/50">
                                <span class="text-orange-700">Tea</span>
                            </th>
                            <th scope="col" class="text-center bg-cyan-50/50">
                                <span class="text-cyan-700">Water</span>
                            </th>
                            <th scope="col" class="text-right">Total</th>
                            <th scope="col" class="text-right">Paid</th>
                            <th scope="col" class="text-right">Balance</th>
                            <th scope="col" class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowIndex = 0; }
                        @foreach (dynamic item in rList)
                        {
                            var balance = (decimal)item.Balance;
                            var hasDues = balance > 0;
                            var filterClass = hasDues ? "has-dues" : "fully-paid";
                            var userName = (string)item.User.FullName;
                            <tr class="@filterClass hover:bg-blue-50/50 transition-colors cursor-pointer"
                                x-show="(filter === 'all' || (filter === 'dues' && @(hasDues ? "true" : "false")) || (filter === 'paid' && @(!hasDues ? "true" : "false"))) && ($el.dataset.name.toLowerCase().includes(search.toLowerCase()))"
                                data-name="@userName"
                                onclick="window.location.href='@Url.Action("MemberDetail", "Payment", new { userId = item.User.UserId, periodId = selectedPeriod.PeriodId })'">
                                <td>
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white font-semibold text-sm shadow-sm">
                                            @userName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <p class="font-medium text-gray-900">@userName</p>
                                            <p class="text-xs text-gray-500">@@@item.User.Username</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center bg-amber-50/30">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-amber-100 text-amber-700 font-semibold text-sm">
                                        @item.BreakfastCount
                                    </span>
                                </td>
                                <td class="text-center bg-blue-50/30">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-blue-100 text-blue-700 font-semibold text-sm">
                                        @item.LunchCount
                                    </span>
                                </td>
                                <td class="text-center bg-purple-50/30">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-purple-100 text-purple-700 font-semibold text-sm">
                                        @item.DinnerCount
                                    </span>
                                </td>
                                <td class="text-right">
                                    <span class="font-medium">Rs. @(((decimal)item.MealCharges).ToString("N0"))</span>
                                </td>
                                <td class="text-center bg-orange-50/30">
                                    <div class="flex flex-col items-center">
                                        <span class="text-xs text-gray-500">@item.TeaCups cups</span>
                                        <span class="font-medium text-orange-600">Rs. @(((decimal)item.TeaCharges).ToString("N0"))</span>
                                    </div>
                                </td>
                                <td class="text-center bg-cyan-50/30">
                                    <span class="font-medium text-cyan-600">Rs. @(((decimal)item.WaterCharges).ToString("N0"))</span>
                                </td>
                                <td class="text-right">
                                    <span class="font-semibold text-gray-900">Rs. @(((decimal)item.TotalCharges).ToString("N0"))</span>
                                </td>
                                <td class="text-right">
                                    <span class="font-semibold text-green-600">Rs. @(((decimal)item.Payments).ToString("N0"))</span>
                                </td>
                                <td class="text-right px-4">
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold @(hasDues ? "bg-red-100 text-red-700 border border-red-200" : "bg-green-100 text-green-700 border border-green-200")">
                                        @(hasDues ? "Due" : "Paid") Rs. @Math.Abs(balance).ToString("N0")
                                    </span>
                                </td>
                                <td class="text-center px-4 no-print" onclick="event.stopPropagation()">
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="@Url.Action("MemberDetail", "Payment", new { userId = item.User.UserId, periodId = selectedPeriod.PeriodId })" 
                                           class="p-2 rounded-lg hover:bg-blue-100 text-blue-600 transition-colors" title="View Details">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </a>
                                        <a href="@Url.Action("ExportUserDetail", new { periodId = selectedPeriod.PeriodId, userId = item.User.UserId })" 
                                           class="p-2 rounded-lg hover:bg-green-100 text-green-600 transition-colors" title="Export User Report">
                                            <i data-lucide="download" class="w-4 h-4"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-50">
                        <tr class="font-semibold">
                            <td class="px-4 py-3">
                                <span class="text-gray-900">Total (@rList.Count members)</span>
                            </td>
                            <td class="text-center bg-amber-50/50">
                                <span class="text-amber-700">@totalBreakfast</span>
                            </td>
                            <td class="text-center bg-blue-50/50">
                                <span class="text-blue-700">@totalLunch</span>
                            </td>
                            <td class="text-center bg-purple-50/50">
                                <span class="text-purple-700">@totalDinner</span>
                            </td>
                            <td class="text-right">Rs. @totalMealCharges.ToString("N0")</td>
                            <td class="text-center bg-orange-50/50">
                                <span class="text-orange-700">Rs. @totalTeaCharges.ToString("N0")</span>
                            </td>
                            <td class="text-center bg-cyan-50/50">
                                <span class="text-cyan-700">Rs. @totalWaterCharges.ToString("N0")</span>
                            </td>
                            <td class="text-right">Rs. @totalCharges.ToString("N0")</td>
                            <td class="text-right text-green-600">Rs. @totalPaid.ToString("N0")</td>
                            <td class="text-right @(totalBalance > 0 ? "text-red-600" : "text-green-600")">Rs. @totalBalance.ToString("N0")</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i data-lucide="file-x" class="w-16 h-16 text-gray-300"></i>
                    </div>
                    <h3 class="empty-state-title">No Data Available</h3>
                    <p class="empty-state-description">There are no records for the selected period.</p>
                </div>
            </div>
        }
        <div class="card-footer flex flex-col sm:flex-row justify-between items-center gap-4 no-print">
            <p class="text-sm text-gray-500">
                <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                Report generated on @DateTime.Now.ToString("MMMM dd, yyyy HH:mm")
            </p>
            <div class="flex items-center gap-2">
                <a href="@Url.Action("ExportSummary", new { periodId = selectedPeriod.PeriodId })" class="btn btn-secondary">
                    <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                    Export CSV
                </a>
                <button onclick="window.print()" class="btn btn-primary">
                    <i data-lucide="printer" class="w-4 h-4"></i>
                    Print Report
                </button>
            </div>
        </div>
    </div>
}
else
{
    <!-- No Report Selected -->
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center mb-4">
                    <i data-lucide="file-search" class="w-10 h-10 text-blue-600"></i>
                </div>
                <h3 class="empty-state-title">Select a Period</h3>
                <p class="empty-state-description">Choose a billing period above to generate the monthly report.</p>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script>
        lucide.createIcons();
    </script>
}
